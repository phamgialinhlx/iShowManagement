<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS refuses camera access outright to a process with no usage string —
	     getUserMedia rejects and nothing explains why. This text is what the
	     system permission prompt shows, so it says what the camera is for and,
	     just as importantly, what leaves the machine. -->
	<key>NSCameraUsageDescription</key>
	<string>rmux uses the camera only to unlock the app with your face. Video stays on this machine; only a numeric face signature is sent to your Cowork server.</string>
</dict>
</plist>
