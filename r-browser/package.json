{
  "name": "r-browser",
  "productName": "R Browser",
  "version": "0.1.0",
  "private": true,
  "description": "The development browser for rmux — pick an element, say what is wrong, hand a coding agent the address.",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "pnpm build && electron .",
    "check": "tsc --noEmit",
    "checks": "node scripts/run-checks.mjs",
    "dist": "pnpm build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "build": {
    "appId": "group.yitec.rbrowser",
    "productName": "R Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        "dir"
      ]
    }
  }
}
