# Rust
/target
**/*.rs.bk

# Node / Vite
node_modules
/dist
*.tsbuildinfo

# Tauri build output
/src-tauri/target
/src-tauri/gen

# Local tooling artifacts
.playwright-mcp/
*.log

# Screenshots taken during development
rmux-m0*.png

# The cross-compiled remote agents: multi-MB binaries, rebuilt by
# scripts/build-agents.sh and shipped as bundle resources.
/src-tauri/agents/

# Secrets — never commit
.env
.env.*
!.env.example
.creds

# Deployment-specific notes: hostnames, org name, accounts, machines, signing
# identity. Ignored deliberately — this repository is meant to be shareable, and
# a hostname committed once stays in the history forever. Everything tracked
# must stay generic; the live tests read RMUX_LIVE_SERVER instead.
CLAUDE.local.md
*.local.md

# Signing material. A .p12 carries a private key.
*.p12
*.cer
*.der
*.mobileprovision

.DS_Store

# The vendored Cowork server.
#
# Kept out of the published branch deliberately. It has been scrubbed of every
# deployment identifier (see the ORG_NAME / COWORK_PUBLIC_URL env knobs), so it
# *can* be published — but that is a decision to make on purpose, not a default,
# and it is a separate project with its own history.
server/

# The askpass sidecar: a host-native binary staged by scripts/build-askpass.mjs
# on every `pnpm build`, so it is always rebuilt rather than committed.
/src-tauri/binaries/
# Reference material read for design/feature history — not authored work.
# zed is a 580MB clone (own nested .git); tsmanager is the project being ported.
references/ui-ux
references/zed
references/tsmanager
tmp/
web/dist
ui/dist
